{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "romionologic",
  "main": "src/index.js",
  "compatibility_date": "2026-05-10",
  "compatibility_flags": ["nodejs_compat"],

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  },

  "assets": {
    "directory": "./static",
    "binding": "ASSETS"
  },

  "upload_source_maps": true
}
